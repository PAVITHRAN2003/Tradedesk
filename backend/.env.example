MONGO_URL=mongodb://localhost:27017
MONGO_DB=tradedesk
# generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
ACCESS_MINUTES=15
REFRESH_DAYS_SESSION=1
REFRESH_DAYS_REMEMBER=30
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
GROQ_API_KEY=
# free-tier friendly, good at tool calling. Alternative: openai/gpt-oss-120b
GROQ_MODEL=llama-3.3-70b-versatile
# only these Bright Data tools are given to the agents (keeps prompts small for Groq's token limits)
BRIGHT_DATA_TOOLS=search_engine,scrape_as_markdown
TOOL_OUTPUT_MAX_CHARS=6000
BRIGHT_DATA_API_TOKEN=
WEB_UNLOCKER_ZONE=unblocker
BROWSER_ZONE=scraping_browser
