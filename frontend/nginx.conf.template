server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Anything starting with /api goes to the backend container. The browser only ever
    # talks to one origin, so the login cookie works exactly like it did with Vite's proxy.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # React Router: unknown paths must serve index.html
    location / {
        try_files $uri /index.html;
    }
}